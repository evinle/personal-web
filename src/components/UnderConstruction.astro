---
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  current: string;
}

const { title, current } = Astro.props;
---

<Base title={`Evin Le — ${title}`} current={current}>
  <main>
    <header style="padding:64px 0 0">
      <span class="label el-muted">{current.toUpperCase()}</span>
      <h1 class="display el-h" style="margin:16px 0">Under construction</h1>
    </header>
    <p class="body el-text el-muted">Nothing here yet. In the meantime, there's <a class="el-link el-mono" href="/about">/about</a>.</p>
  </main>
</Base>
