---
interface Props {
  kind: 'diploma' | 'badge';
}

const { kind } = Astro.props;
---

{
  kind === 'diploma' ? (
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M7 3h10v13l-5-2.5L7 16V3Z" stroke-linejoin="round" />
      <path d="M4.5 19.5 7 15l2 1" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M19.5 19.5 17 15l-2 1" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  ) : (
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="12" cy="9" r="6" />
      <path d="M9 14.5 7.5 21l4.5-2.5 4.5 2.5L15 14.5" stroke-linejoin="round" stroke-linecap="round" />
      <path d="M9.5 9h5M12 6.5v5" stroke-linecap="round" />
    </svg>
  )
}
