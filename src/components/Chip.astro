---
import { glyphChar } from '../lib/glyphs';

interface Props {
  label: string;
  icon?: string;
  popoverTarget?: string;
}

const { label, icon, popoverTarget } = Astro.props;
const char = glyphChar(icon);
const name = label.toLowerCase();
---

{popoverTarget
  ? <button type="button" class="el-stack" popovertarget={popoverTarget}>{char && <i class="nf" aria-hidden="true">{char}</i>}<span class="el-stack-name">{name}</span></button>
  : <span class="el-stack">{char && <i class="nf" aria-hidden="true">{char}</i>}{name}</span>}
