---
import Base from '../layouts/Base.astro';
import Popover from '../components/Popover.astro';
import TechnologyChips from '../components/TechnologyChips.astro';
import TechnologyNotes from '../components/TechnologyNotes.astro';
import QualificationIcon from '../components/QualificationIcon.astro';
import GanttYearLines from '../components/GanttYearLines.astro';
import Terminal from '../components/terminal/Terminal';
import { buildGanttAxis, ym } from '../lib/ganttAxis';
import { countLabel, projectDetailSections, projectPopoverId, projectTechnologiesPopoverId } from '../lib/popovers';
import { buildTerminalCommands } from '../lib/terminalCommands';
import { getCollection, getEntry, render } from 'astro:content';
import { testIds } from '../testIds';

function required<T>(entry: T | undefined, label: string): T {
  if (entry === undefined) throw new Error(`Missing required content entry: ${label}`);
  return entry;
}

const home = required(await getEntry('home', 'index'), 'home/index').data;
const whoami = required(await getEntry('whoami', 'index'), 'whoami/index').data;
const qualifications = required(await getEntry('qualifications', 'index'), 'qualifications/index').data;
const contact = required(await getEntry('contact', 'index'), 'contact/index').data;
const introEntry = required(await getEntry('intro', 'index'), 'intro/index');
const { Content: Intro } = await render(introEntry);

const principles = (await getCollection('principles')).sort((a, b) => a.data.order - b.data.order);
const stackGroups = (await getCollection('stack')).sort((a, b) => a.data.order - b.data.order);
const technologies = await getCollection('technologies');
const technologyById = new Map(technologies.map((t) => [t.id, t.data]));

const projects = (await getCollection('projects')).sort((a, b) => ym(a.data.start) - ym(b.data.start));

const today = new Date().toISOString().slice(0, 10);
const { start: axisStart, span, pct, years, yearLines } = buildGanttAxis(
  projects[0].data.start,
  projects.map((project) => project.data.end ?? today),
  today,
);
const nowPct = pct(today);

const whoamiSummary = `${whoami.role[0].toUpperCase()}${whoami.role.slice(1)} at ${whoami.at} since ${whoami.since}, based in ${whoami.based}.`;

const terminalCommands = buildTerminalCommands({
  whoami,
  qualifications,
  stack: stackGroups.map((group) => ({
    name: group.data.name,
    technologies: group.data.technologies.flatMap((ref) => technologyById.get(ref.id)?.label.toLowerCase() ?? []),
  })),
  principles: principles.map((principle) => principle.data.title),
});

function barClass(project: { tone: string; end?: string; noteSide?: string }) {
  const modifiers = [
    project.tone === 'mint' && 'react',
    !project.end && 'ongoing',
    project.noteSide === 'left' && 'note-left',
  ];
  return ['el-bar', ...modifiers.filter(Boolean)].join(' ');
}

const parent = {
  name: `${whoami.at.toLowerCase().replace(/\s+/g, '-')}/`,
  subtitle: whoami.role,
  start: projects[0].data.start,
};
---

<Base title="Evin Le" current="home">
  <header style="padding:64px 0 0">
    <p class="heading el-h" style="margin:0">{home.headline}</p>
    <h1 class="display el-h" style="margin:16px 0">{whoami.name}</h1>
    <p class="small el-text el-muted" style="margin:0 0 16px">{whoamiSummary}</p>
  </header>

  <div class="el-intro">
    <div class="body el-text el-intro-prose">
      <Intro />
    </div>
    <Terminal client:load commands={terminalCommands} />
  </div>

  <section class="el-section" aria-labelledby="results">
    <div class="el-section-head">
      <h2 id="results" class="heading el-h"><span class="el-hash">## </span>Some numbers</h2>
    </div>
    <div class="el-metrics">
      {home.metrics.map(({ before, after, label }) => (
        <div class="el-metric">
          <div class="el-metric-vals">
            <span class="el-metric-before">{before}</span>
            <span class="el-visually-hidden">to</span>
            <span class="el-metric-arrow" aria-hidden="true">→</span>
            <span class="el-metric-after">{after}</span>
          </div>
          <p class="small el-text el-muted">{label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="el-section" aria-labelledby="exp">
    <div class="el-section-head">
      <h2 id="exp" class="heading el-h"><span class="el-hash">## </span>Experience</h2>
    </div>
    <div class="el-gantt-scroll">
    <div
      class="el-gantt"
      role="group"
      aria-label={`Timeline of projects at ${whoami.at} from ${projects[0].data.start} to now.`}
      data-testid={testIds.aboutGantt}
      data-axis-start={axisStart}
      data-axis-span={span}
    >
      <div class="el-gantt-axis">
        <div class="el-gantt-label"><span class="label">PROJECT</span></div>
        <div class="el-gantt-track el-gantt-track-years">
          <GanttYearLines years={yearLines} />
          {years.map((y) => (
            <span class={`el-gantt-year${y.month ? ' el-gantt-year-first' : ''}`} style={`left:${y.left}%`}>{y.month && <span class="el-gantt-year-month">{y.month} </span>}{y.year}</span>
          ))}
          <div class="el-now" data-testid={testIds.aboutGanttNowMarker} style={`--n:${nowPct}`}><span>now</span></div>
        </div>
      </div>

      <div class="el-gantt-row">
        <div class="el-gantt-label">
          <span class="name">{parent.name}</span>
          <span class="small el-muted">{parent.subtitle}</span>
        </div>
        <div class="el-gantt-track el-gantt-track-years">
          <GanttYearLines years={yearLines} />
          <div class="el-bar-summary" data-end="now" style={`--s:${pct(parent.start)};--e:${nowPct}`} />
          <div class="el-now" style={`--n:${nowPct}`} />
        </div>
      </div>

      {projects.map((project, i) => {
        const s = pct(project.data.start);
        const e = project.data.end ? pct(project.data.end) : nowPct;
        const popoverId = projectPopoverId(project.id);
        return (
          <div class="el-gantt-row">
            <div class="el-gantt-label child branched">
              <span class="el-gantt-branch" aria-hidden="true" data-testid={testIds.aboutGanttBranch}>{i === projects.length - 1 ? '└─' : '├─'}</span>
              <button type="button" class="name el-gantt-name" popovertarget={popoverId}>{project.data.name}</button>
              <TechnologyChips technologies={project.data.technologies} />
              <button
                type="button"
                class="el-gantt-tech-count"
                popovertarget={projectTechnologiesPopoverId(project.id)}
                aria-label={`${project.data.name}: ${countLabel(project.data.technologies.length, 'technology', 'technologies')}`}
              >{countLabel(project.data.technologies.length, 'technology', 'technologies')}</button>
            </div>
            <div class="el-gantt-track el-gantt-track-years">
              <GanttYearLines years={yearLines} />
              <button
                type="button"
                class={barClass(project.data)}
                data-end={project.data.end ? undefined : 'now'}
                data-testid={project.data.end ? undefined : testIds.aboutGanttOngoingBar}
                style={`--s:${s};--e:${e}`}
                title={project.data.name}
                popovertarget={popoverId}
                aria-label={`${project.data.name}: show details`}
              >
                <span class="el-bar-hint" aria-hidden="true" data-testid={testIds.aboutGanttNoteHint}>[+]</span>
              </button>
              {project.data.note && (
                <span
                  class={`el-bar-note ${project.data.noteSide === 'left' ? 'left' : ''}`}
                  data-end={project.data.end ? undefined : 'now'}
                  style={`--s:${s};--e:${e}`}
                >
                  {project.data.note}
                </span>
              )}
              <div class="el-now" style={`--n:${nowPct}`} />
            </div>
          </div>
        );
      })}
    </div>
    </div>
    {projects.map((project) => (
      <Popover id={projectPopoverId(project.id)} title={project.data.name}>
        <p class="small el-text el-muted" style="margin:0">{project.data.note}</p>
        <dl style="margin:0">
          {projectDetailSections(project.data.detail).map(({ label, tone, text }) => (
            <div class="el-popover-section">
              <dt class={`label ${tone}`}>{label}</dt>
              <dd class="body el-text">{text}</dd>
            </div>
          ))}
        </dl>
      </Popover>
    ))}
    {projects.map((project) => (
      <Popover id={projectTechnologiesPopoverId(project.id)} label={`${project.data.name} technologies`}>
        <TechnologyChips technologies={project.data.technologies} />
      </Popover>
    ))}
  </section>

  <script>
    import { correctGanttToLiveDate } from '../lib/ganttEnhancements';
    import { closePopoversOutOfView } from '../lib/popoverEnhancements';

    correctGanttToLiveDate(document, new Date().toISOString().slice(0, 10));
    closePopoversOutOfView(document);
  </script>

  <section class="el-section" aria-labelledby="how">
    <div class="el-section-head">
      <h2 id="how" class="heading el-h"><span class="el-hash">## </span>How I work</h2>
    </div>
    <div class="el-tiles">
      {principles.map((p, i) => (
        <div class="el-card">
          <h3 class="el-h3 el-h">
            <span class="el-blue">0{i + 1}</span> {p.data.title}
          </h3>
          <p class="body el-text el-muted">{p.data.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="el-section" aria-labelledby="qualifications">
    <div class="el-section-head">
      <h2 id="qualifications" class="heading el-h"><span class="el-hash">## </span>Qualifications</h2>
    </div>

    <div class="qual-sub">
      <span class="label el-muted qual-sub-label">EDUCATION</span>
      <div class="qual-list">
        <div class="qual-row">
          <div class="qual-icon">
            <QualificationIcon kind="diploma" />
          </div>
          <div class="qual-body">
            <h3 class="el-h3 el-h">{qualifications.studied.degree}</h3>
            <p class="body el-text">
              Studied at {qualifications.studied.at}, graduating with {qualifications.studied.grade}.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="qual-sub">
      <span class="label el-muted qual-sub-label">CERTIFICATIONS</span>
      <div class="qual-list">
        {qualifications.certs.map((cert) => (
          <div class="qual-row cert">
            <div class="qual-icon">
              <QualificationIcon kind="badge" />
            </div>
            <div class="qual-body">
              <h3 class="el-h3 el-h">{cert.name}</h3>
              <p class="body el-text el-muted">{cert.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="el-section" aria-labelledby="stack">
    <div class="el-section-head">
      <h2 id="stack" class="heading el-h"><span class="el-hash">## </span>Stack</h2>
    </div>
    <dl class="code" style="display:grid;grid-template-columns:120px 1fr;gap:8px 16px;margin:0">
      {stackGroups.map((group) => (
        <>
          <dt style="color:var(--ink-muted)">{group.data.name}</dt>
          <dd style="margin:0"><TechnologyChips technologies={group.data.technologies} /></dd>
        </>
      ))}
    </dl>
    <TechnologyNotes />
  </section>

  <section class="el-section" aria-labelledby="contact">
    <div class="el-section-head">
      <h2 id="contact" class="heading el-h"><span class="el-hash">## </span>Get in touch</h2>
    </div>
    <p class="small el-text el-muted" style="margin:0 0 16px">Status: {whoami.status}.</p>
    <div style="display:flex;gap:16px;flex-wrap:wrap">
      <a class="el-btn el-btn-primary" href={`mailto:${contact.email}`}>{contact.email}</a>
      <a class="el-btn" href={contact.github} target="_blank" rel="noreferrer">{contact.github.replace('https://', '')}</a>
      <a class="el-btn" href={contact.npm} target="_blank" rel="noreferrer">{contact.npm.replace('https://www.', '').replace('https://', '')}</a>
    </div>
  </section>
</Base>
