---
import Base from '../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';

const whoami = (await getEntry('whoami', 'index'))!.data;
const contact = (await getEntry('contact', 'index'))!.data;
const introEntry = (await getEntry('intro', 'index'))!;
const { Content: Intro } = await render(introEntry);

const principles = (await getCollection('principles')).sort((a, b) => a.data.order - b.data.order);
const stackGroups = await getCollection('stack');
const technologies = await getCollection('technologies');
const technologyById = new Map(technologies.map((t) => [t.id, t.data]));
const projects = await getCollection('projects');

function ym(s: string) {
  const [y, m = '1', d = '1'] = s.split('-');
  return Number(y) * 12 + (Number(m) - 1) + (Number(d) - 1) / 30;
}

const today = new Date().toISOString().slice(0, 10);
const projectStarts = projects.map((p) => ym(p.data.start));
const projectEnds = projects.map((p) => (p.data.end ? ym(p.data.end) : ym(today)));
const axisStart = Math.min(...projectStarts);
const axisEnd = Math.max(ym(today), ...projectEnds) + 1;
const span = axisEnd - axisStart;
const pct = (s: string) => Math.max(0, Math.min(100, ((ym(s) - axisStart) / span) * 100));
const nowPct = pct(today);

const years: Array<{ year: number; left: number }> = [];
for (let y = Math.ceil(axisStart / 12); y * 12 < axisEnd; y++) {
  years.push({ year: y, left: ((y * 12 - axisStart) / span) * 100 });
}
---

<Base title="Evin Le — About" current="about">
  <header style="padding:64px 0 0">
    <span class="label el-muted">ABOUT</span>
    <h1 class="display el-h" style="margin:16px 0">{whoami.name}</h1>
  </header>

  <div style="display:grid;grid-template-columns:1fr;gap:16px">
    <Intro />
  </div>

  <section class="el-section" aria-labelledby="exp">
    <div class="el-section-head">
      <h2 id="exp" class="heading el-h">Experience</h2>
    </div>
    <div
      class="el-gantt"
      role="img"
      aria-label={`Timeline of projects from ${projects[0]?.data.start} to now.`}
    >
      <div class="el-gantt-axis">
        <div class="el-gantt-label"><span class="label">PROJECT</span></div>
        <div class="el-gantt-track">
          {years.map((y) => (
            <span class="el-gantt-year" style={`left:${y.left}%`}>{y.year}</span>
          ))}
          <div class="el-now" style={`--n:${nowPct}`}><span>now</span></div>
        </div>
      </div>
      {projects.map((project) => {
        const s = pct(project.data.start);
        const e = project.data.end ? pct(project.data.end) : nowPct;
        const projectTechnologies = project.data.technologies
          .map((ref) => technologyById.get(ref.id))
          .filter(Boolean);
        return (
          <div class="el-gantt-row">
            <div class="el-gantt-label">
              <span class="name">{project.data.name}</span>
              <span class="el-chips">
                {projectTechnologies.map((t) => (
                  <span class="el-stack">{t!.label.toLowerCase()}</span>
                ))}
              </span>
            </div>
            <div class="el-gantt-track">
              <div
                class={`el-bar ${project.data.tone === 'mint' ? 'react' : ''} ${project.data.end ? '' : 'ongoing'}`}
                style={`--s:${s};--e:${e}`}
                title={project.data.name}
              />
              {project.data.note && (
                <span class="el-bar-note" style={`--s:${s};--e:${e}`}>{project.data.note}</span>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <section class="el-section" aria-labelledby="how">
    <div class="el-section-head">
      <h2 id="how" class="heading el-h">How I work</h2>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
      {principles.map((p, i) => (
        <div class="el-card">
          <h3 class="el-h3 el-h">
            <span class="el-blue">0{i + 1}</span> {p.data.title}
          </h3>
          <p class="body el-text el-muted">{p.data.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="el-section" aria-labelledby="stack">
    <div class="el-section-head">
      <h2 id="stack" class="heading el-h">Stack</h2>
    </div>
    <dl class="code" style="display:grid;grid-template-columns:120px 1fr;gap:8px 16px;margin:0">
      {stackGroups.map((group) => (
        <>
          <dt style="color:var(--ink-muted)">{group.data.name}</dt>
          <dd style="margin:0">
            <span class="el-chips">
              {group.data.technologies.map((ref) => {
                const tech = technologyById.get(ref.id);
                return tech ? <span class="el-stack">{tech.label.toLowerCase()}</span> : null;
              })}
            </span>
          </dd>
        </>
      ))}
    </dl>
  </section>

  <section class="el-section" aria-labelledby="contact">
    <div class="el-section-head">
      <h2 id="contact" class="heading el-h">Get in touch</h2>
    </div>
    <div style="display:flex;gap:16px;flex-wrap:wrap">
      <a class="el-btn el-btn-primary" href={`mailto:${contact.email}`}>{contact.email}</a>
      <a class="el-btn" href={contact.github}>{contact.github.replace('https://', '')}</a>
      <a class="el-btn" href={contact.npm}>{contact.npm.replace('https://www.', '').replace('https://', '')}</a>
    </div>
  </section>
</Base>
