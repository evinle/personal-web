---
import Base from '../layouts/Base.astro';
import Chip from '../components/Chip.astro';
import QualificationIcon from '../components/QualificationIcon.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { testIds } from '../testIds';

function required<T>(entry: T | undefined, label: string): T {
  if (entry === undefined) throw new Error(`Missing required content entry: ${label}`);
  return entry;
}

const whoami = required(await getEntry('whoami', 'index'), 'whoami/index').data;
const qualifications = required(await getEntry('qualifications', 'index'), 'qualifications/index').data;
const contact = required(await getEntry('contact', 'index'), 'contact/index').data;
const introEntry = required(await getEntry('intro', 'index'), 'intro/index');
const { Content: Intro } = await render(introEntry);

const principles = (await getCollection('principles')).sort((a, b) => a.data.order - b.data.order);
const stackGroups = await getCollection('stack');
const technologies = await getCollection('technologies');
const technologyById = new Map(technologies.map((t) => [t.id, t.data]));

function ym(s: string) {
  const [y, m = '1', d = '1'] = s.split('-');
  return Number(y) * 12 + (Number(m) - 1) + (Number(d) - 1) / 30;
}

const projects = (await getCollection('projects')).sort((a, b) => ym(a.data.start) - ym(b.data.start));

// Computed here, not inside the template's {projects.map(...)} block: astro-eslint-parser's
// tag-aware tokenizer misreads the `<NonNullable<typeof t>>` generic as an HTML tag when it
// appears inside a template expression, desyncing it for the rest of the file.
const projectTechnologiesById = new Map(
  projects.map((project) => [
    project.id,
    project.data.technologies
      .map((ref) => technologyById.get(ref.id))
      .filter((t): t is NonNullable<typeof t> => t != null),
  ])
);

const today = new Date().toISOString().slice(0, 10);
const projectEnds = projects.map((p) => (p.data.end ? ym(p.data.end) : ym(today)));
const axisStart = ym(projects[0].data.start);
const axisEnd = Math.max(ym(today), ...projectEnds) + 1;
const span = axisEnd - axisStart;
const pct = (s: string) => Math.max(0, Math.min(100, ((ym(s) - axisStart) / span) * 100));
const nowPct = pct(today);

const years: Array<{ year: number; left: number }> = [];
for (let y = Math.ceil(axisStart / 12); y * 12 < axisEnd; y++) {
  years.push({ year: y, left: ((y * 12 - axisStart) / span) * 100 });
}

const parent = {
  name: `${whoami.at.toLowerCase().replace(/\s+/g, '-')}/`,
  subtitle: whoami.role,
  start: projects[0].data.start,
};
---

<Base title="Evin Le — About" current="about">
  <header style="padding:64px 0 0">
    <span class="label el-muted">ABOUT</span>
    <h1 class="display el-h" style="margin:16px 0">{whoami.name}</h1>
  </header>

  <div class="body el-text" style="display:grid;grid-template-columns:1fr;gap:16px">
    <Intro />
  </div>

  <section class="el-section" aria-labelledby="exp">
    <div class="el-section-head">
      <h2 id="exp" class="heading el-h"><span class="el-hash">## </span>Experience</h2>
    </div>
    <div
      class="el-gantt"
      role="img"
      aria-label={`Timeline of projects at ${whoami.at} from ${projects[0].data.start} to now.`}
      data-testid={testIds.aboutGantt}
      data-axis-start={axisStart}
      data-axis-span={span}
    >
      <div class="el-gantt-axis">
        <div class="el-gantt-label"><span class="label">PROJECT</span></div>
        <div class="el-gantt-track">
          {years.map((y) => (
            <span class="el-gantt-year" style={`left:${y.left}%`}>{y.year}</span>
          ))}
          <div class="el-now" data-testid={testIds.aboutGanttNowMarker} style={`--n:${nowPct}`}><span>now</span></div>
        </div>
      </div>

      <div class="el-gantt-row">
        <div class="el-gantt-label">
          <span class="name">{parent.name}</span>
          <span class="small el-muted">{parent.subtitle}</span>
        </div>
        <div class="el-gantt-track">
          <div class="el-bar-summary" data-end="now" style={`--s:${pct(parent.start)};--e:${nowPct}`} />
          <div class="el-now" style={`--n:${nowPct}`} />
        </div>
      </div>

      {projects.map((project) => {
        const s = pct(project.data.start);
        const e = project.data.end ? pct(project.data.end) : nowPct;
        const projectTechnologies = projectTechnologiesById.get(project.id) ?? [];
        return (
          <div class="el-gantt-row">
            <div class="el-gantt-label child">
              <span class="name">{project.data.name}</span>
              <span class="el-chips">
                {projectTechnologies.map((t) => <Chip label={t.label} icon={t.icon} />)}
              </span>
            </div>
            <div class="el-gantt-track">
              <div
                class={`el-bar ${project.data.tone === 'mint' ? 'react' : ''} ${project.data.end ? '' : 'ongoing'}`}
                data-end={project.data.end ? undefined : 'now'}
                data-testid={project.data.end ? undefined : testIds.aboutGanttOngoingBar}
                style={`--s:${s};--e:${e}`}
                title={project.data.name}
              />
              {project.data.note && (
                <span
                  class={`el-bar-note ${project.data.noteSide === 'left' ? 'left' : ''}`}
                  data-end={project.data.end ? undefined : 'now'}
                  style={`--s:${s};--e:${e}`}
                >
                  {project.data.note}
                </span>
              )}
              <div class="el-now" style={`--n:${nowPct}`} />
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <script>
    (function correctGanttToLiveDate() {
      function ym(s: string) {
        const [y, m = '1', d = '1'] = s.split('-');
        return Number(y) * 12 + (Number(m) - 1) + (Number(d) - 1) / 30;
      }

      document.querySelectorAll<HTMLElement>('.el-gantt[data-axis-start]').forEach((gantt) => {
        const axisStart = Number(gantt.dataset.axisStart);
        const span = Number(gantt.dataset.axisSpan);
        const today = new Date().toISOString().slice(0, 10);
        const pct = Math.max(0, Math.min(100, ((ym(today) - axisStart) / span) * 100));

        gantt.querySelectorAll<HTMLElement>('.el-now').forEach((el) => {
          el.style.setProperty('--n', String(pct));
        });
        gantt.querySelectorAll<HTMLElement>('[data-end="now"]').forEach((el) => {
          el.style.setProperty('--e', String(pct));
        });
      });
    })();
  </script>

  <section class="el-section" aria-labelledby="how">
    <div class="el-section-head">
      <h2 id="how" class="heading el-h"><span class="el-hash">## </span>How I work</h2>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
      {principles.map((p, i) => (
        <div class="el-card">
          <h3 class="el-h3 el-h">
            <span class="el-blue">0{i + 1}</span> {p.data.title}
          </h3>
          <p class="body el-text el-muted">{p.data.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="el-section" aria-labelledby="qualifications">
    <div class="el-section-head">
      <h2 id="qualifications" class="heading el-h"><span class="el-hash">## </span>Qualifications</h2>
    </div>

    <div class="qual-sub">
      <span class="label el-muted qual-sub-label">EDUCATION</span>
      <div class="qual-list">
        <div class="qual-row">
          <div class="qual-icon">
            <QualificationIcon kind="diploma" />
          </div>
          <div class="qual-body">
            <h3 class="el-h3 el-h">{qualifications.studied.degree}</h3>
            <p class="body el-text">
              Studied at {qualifications.studied.at}, graduating with {qualifications.studied.grade}.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="qual-sub">
      <span class="label el-muted qual-sub-label">CERTIFICATIONS</span>
      <div class="qual-list">
        {qualifications.certs.map((cert) => (
          <div class="qual-row cert">
            <div class="qual-icon">
              <QualificationIcon kind="badge" />
            </div>
            <div class="qual-body">
              <h3 class="el-h3 el-h">{cert.name}</h3>
              <p class="body el-text el-muted">{cert.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="el-section" aria-labelledby="stack">
    <div class="el-section-head">
      <h2 id="stack" class="heading el-h"><span class="el-hash">## </span>Stack</h2>
    </div>
    <dl class="code" style="display:grid;grid-template-columns:120px 1fr;gap:8px 16px;margin:0">
      {stackGroups.map((group) => (
        <>
          <dt style="color:var(--ink-muted)">{group.data.name}</dt>
          <dd style="margin:0">
            <span class="el-chips">
              {group.data.technologies.map((ref) => {
                const tech = technologyById.get(ref.id);
                return tech ? <Chip label={tech.label} icon={tech.icon} /> : null;
              })}
            </span>
          </dd>
        </>
      ))}
    </dl>
  </section>

  <section class="el-section" aria-labelledby="contact">
    <div class="el-section-head">
      <h2 id="contact" class="heading el-h"><span class="el-hash">## </span>Get in touch</h2>
    </div>
    <p class="small el-text el-muted" style="margin:0 0 16px">Status: {whoami.status}.</p>
    <div style="display:flex;gap:16px;flex-wrap:wrap">
      <a class="el-btn el-btn-primary" href={`mailto:${contact.email}`}>{contact.email}</a>
      <a class="el-btn" href={contact.github} target="_blank" rel="noreferrer">{contact.github.replace('https://', '')}</a>
      <a class="el-btn" href={contact.npm} target="_blank" rel="noreferrer">{contact.npm.replace('https://www.', '').replace('https://', '')}</a>
    </div>
  </section>
</Base>

<style>
  .qual-sub {
    margin-top: var(--space-8);
  }
  .qual-sub:first-of-type {
    margin-top: var(--space-4);
  }
  .qual-sub-label {
    display: block;
    margin-bottom: var(--space-2);
  }
  .qual-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .qual-row {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: var(--space-4);
    align-items: stretch;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .qual-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .qual-icon {
    width: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    color: var(--blue);
    flex-shrink: 0;
  }
  .qual-row.cert .qual-icon {
    color: var(--mint);
  }
  .qual-body .el-h3 {
    margin: 0 0 4px;
  }
  .qual-body .body {
    margin: 0;
  }
</style>
